# LANA 系統環境變數範例
# 複製此檔案為 .env 並填入實際值（不要 commit .env 到 Git）

# ── AI API Keys ──
ANTHROPIC_API_KEY=sk-ant-api03-xxxx   # Claude 備援 AI
GEMINI_API_KEY=AIzaxxxx                # Gemini 主 AI（免費）
GEMINI_MODEL=gemini-2.5-flash          # 穩定版，若帳號未開放可在 Railway 覆寫
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Telegram ──
TELEGRAM_TOKEN=1234567890:ABCxxxx      # BotFather 取得
TELEGRAM_CHAT_ID=123456789             # 目標 Chat/Channel ID

# ── 掃描參數（可選，有預設值）──
MIN_SCORE=72                           # LANA 進入 AI 分析的門檻
PUSH_MIN_AI_SCORE=70                   # 推播的 AI 分數下限
TOP_N_PUSH=3                           # 每輪最多推幾個訊號
MARKET_SCAN_MIN_VOL_USD=5000000        # 成交量最低門檻（美元）
MARKET_SCAN_TOP_N=25                   # 動態抓幣取前幾名

# ── Paper Trading（不會送真實訂單）──
PAPER_TRADING_ENABLED=true
PAPER_CAPITAL=10000
PAPER_RISK_PCT=0.5                     # 單筆模擬風險占資金百分比
PAPER_MIN_SIGNAL_SCORE=70
PAPER_MAX_OPEN_POSITIONS=3
PAPER_LEVERAGE=3
PAPER_FEE_RATE=0.0005                  # 單邊手續費假設
PAPER_SLIPPAGE_RATE=0.0005             # 單邊滑價假設
PAPER_TRAILING_PCT=0.02
PAPER_MAX_HOLD_HOURS=24

# —— 手動持倉助手（只通知，不會向交易所下單）——
POSITION_ADD_FRACTION=0.25             # 一次性加倉建議：原倉位 25%
POSITION_ADD_AT_R=0.5                  # 至少已有 +0.5R 才允許建議加倉
POSITION_ADD_MIN_SCORE=75              # 技術方向分數仍須 >= 75
POSITION_TRAILING_PCT=0.02             # TP1 後 2% 移動止損
POSITION_HEARTBEAT_MINUTES=60          # 沒有動作時每 60 分鐘回報續抱
POSITION_DEFAULT_EXCHANGE=BINANCE      # 使用者實際下單交易所；持倉風控必須用同一來源即時價

# ── 系統設定 ──
PYTHONUNBUFFERED=1                     # Railway log 即時輸出
WEB_BASE_URL=https://your-web-url.up.railway.app  # lana-monitor 的 URL
PAPER_MARK_URL=https://your-web-url.up.railway.app/api/paper/mark
PAPER_CAPITAL=800
PAPER_FIXED_MARGIN=45
PAPER_LEVERAGE=8
PAPER_RISK_PCT=1.5
PAPER_TIME_STOP_HOURS=6
PAPER_TIME_STOP_MIN_R=0.3
PAPER_STOP_COOLDOWN_HOURS=8
PAPER_MAX_COIN_STOPS_24H=2
PAPER_TP1_FRACTION=0.4
PAPER_TP2_FRACTION=0.4
